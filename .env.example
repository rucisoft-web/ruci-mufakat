APP_NAME="Ruci MUFAKAT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mufakat.domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# MySQL 8 / MariaDB 10.6+
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tanpa Redis dan tanpa worker antrean: semua proses berjalan langsung (cocok untuk cPanel).
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="mufakat@domainanda.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Ruci MUFAKAT ---
# true = halaman /install aktif (paket siap-upload). Otomatis menjadi false setelah instalasi.
MUFAKAT_INSTALLER=false
# Wajibkan MFA aplikasi autentikator bagi semua pengguna (disarankan untuk pemakaian sungguhan).
MUFAKAT_MFA_REQUIRED=false
# Tombol "Masuk sebagai tamu" di halaman login (hanya bila data demo dimuat).
MUFAKAT_DEMO_GUEST=true
MUFAKAT_DEMO_PASSWORD="Mufakat#2026"
# Admin awal bila memakai `php artisan db:seed` (tanpa data demo).
MUFAKAT_ADMIN_EMAIL=
MUFAKAT_ADMIN_PASSWORD=
# Isi true lalu jalankan `php artisan db:seed` untuk memuat data demo Kimia Farma.
MUFAKAT_DEMO=false
MUFAKAT_PDFTOTEXT_PATH=/usr/bin/pdftotext
MUFAKAT_MAX_UPLOAD_KB=51200

# --- Asisten AI (OpenAI Responses API) ---
# Kosongkan untuk mode referensi demo. Isi kunci untuk AI sungguhan.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=90
MUFAKAT_AI_MAX_PAGES=12
MUFAKAT_AI_MAX_CHARS=2500
MUFAKAT_AI_DEMO_FALLBACK=true
